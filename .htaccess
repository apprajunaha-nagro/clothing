# ----------------------------------------------------------------------
# PGmart E-Commerce - Hostinger Apache & Phusion Passenger Configuration
# ----------------------------------------------------------------------

# 1. Enable Phusion Passenger for Node.js Application
<IfModule mod_passenger.c>
  PassengerEnabled on
  PassengerAppEngine node
  PassengerAppType node
  PassengerStartupFile app.js
</IfModule>

# 2. Allow all REST methods (Prevents 501 Not Implemented on PUT/PATCH/DELETE)
<Limit GET POST PUT DELETE OPTIONS PATCH HEAD>
  Allow from all
</Limit>

<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, x-admin-token"
</IfModule>

# 3. URL Rewriting & SPA Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow existing static files, scripts, images, and bundles directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route /api/ requests to Node.js Passenger application
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^(.*)$ app.js/$1 [QSA,L]

  # Fallback for Single Page Application (SPA) routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 4. Cache-Control: Force fresh HTML on every page load while caching immutable assets
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

