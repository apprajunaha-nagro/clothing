# ----------------------------------------------------------------------
# Phusion Passenger / Apache Node.js Routing Configuration for Hostinger
# ----------------------------------------------------------------------

PassengerEnabled on
PassengerAppEngine node
PassengerAppType node
PassengerStartupFile app.js

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow existing static files (dist/, public/, uploads, JS, CSS) directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Pass all remaining requests to Phusion Passenger Node.js app.js
  RewriteRule ^(.*)$ app.js/$1 [QSA,L]
</IfModule>

