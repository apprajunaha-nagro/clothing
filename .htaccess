# cPanel Apache & Phusion Passenger Configuration for PGmart Node.js
DirectoryIndex server.js

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Do NOT intercept API requests - send directly to Node.js server
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule .* - [L]

  # 2. Serve static assets if file or directory exists
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback to index.html for SPA frontend routing
  RewriteRule ^ index.html [L]
</IfModule>
