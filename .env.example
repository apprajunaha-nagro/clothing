# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Database connection string.
DATABASE_URL="file:./dev.db"

# ADMIN_TOKEN: Secret token used for protecting admin API routes.
ADMIN_TOKEN="pgmart123"

# SMTP Email Settings
SMTP_HOST="mail.pgmart.in"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@pgmart.in"
SMTP_PASS="your_email_account_password"
SMTP_FROM_NAME="PGmart"
ADMIN_EMAIL="admin@pgmart.in"
