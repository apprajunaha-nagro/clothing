# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://pgmart.in"

# DATABASE_URL: PostgreSQL Supabase Database connection string.
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# ADMIN_TOKEN: Secret token used for protecting admin API routes.
ADMIN_TOKEN="your_admin_secret_token"

# Supabase Auth Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Resend API Key for Email Delivery
RESEND_API_KEY="your_resend_api_key_here"

# SMTP Email Settings
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@pgmart.in"
SMTP_PASS="your_email_account_password"
SMTP_FROM_NAME="PGmart"
ADMIN_EMAIL="admin@pgmart.in"

# Razorpay Payment Gateway Credentials (Test: rzp_test_... or Live: rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
